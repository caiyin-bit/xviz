{
  "name": "@minimal-viz/maps",
  "version": "0.1.0",
  "description": "Optional satellite package for xviz — adds 13 deck.gl-powered map chart types (PointClusterMap, Cartodiagram, DeckGL Arc/Geojson/Grid/Hex/Heatmap/Multi/Path/Polygon/Scatter/Screengrid/Contour). Uses maplibre-gl@^5 (BSD-3 license, no token required).",
  "keywords": [
    "react",
    "charts",
    "maps",
    "deck.gl",
    "maplibre",
    "echarts",
    "geospatial",
    "choropleth",
    "satellite-package"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/caiyin-bit/xviz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiyin-bit/xviz.git",
    "directory": "minimal-viz-maps"
  },
  "bugs": {
    "url": "https://github.com/caiyin-bit/xviz/issues"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@minimal-viz/core": "^1.0.0 || ^0.10.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.2.0",
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/geo-layers": "^9.2.0",
    "@deck.gl/layers": "^9.2.0",
    "@deck.gl/mapbox": "^9.2.0",
    "@deck.gl/mesh-layers": "^9.2.0",
    "@math.gl/web-mercator": "^4.1.0",
    "maplibre-gl": "^5.0.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supercluster": "^7.1.3",
    "typescript": "~5.6.0",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "lint": "echo 'maps package uses xviz-cli ESLint config when bundled there' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
