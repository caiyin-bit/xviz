{
  "name": "xviz-cli",
  "version": "0.9.0",
  "description": "Headless chart renderer — turn JSON, CSV, or SQL query results into PNG / PDF / HTML. Ships render / query / serve / mcp commands.",
  "keywords": [
    "chart",
    "charts",
    "visualization",
    "headless",
    "cli",
    "puppeteer",
    "echarts",
    "csv",
    "sql",
    "mcp",
    "png",
    "pdf"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/caiyin-bit/xviz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiyin-bit/xviz.git",
    "directory": "xviz-cli"
  },
  "bugs": {
    "url": "https://github.com/caiyin-bit/xviz/issues"
  },
  "type": "module",
  "bin": {
    "xviz": "bin/xviz.mjs"
  },
  "files": [
    "bin",
    "dist/renderer/index.html",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:csv": "node test/csv-compat.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "puppeteer-core": "^24.42.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "echarts": "^6.0.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^2.1.9"
  }
}
