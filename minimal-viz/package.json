{
  "name": "@minimal-viz/core",
  "version": "0.2.0",
  "description": "Lightweight React chart components (Pie, Bar, Line, Table, BigNumber, Scatter, Heatmap, Sankey, Funnel, Gauge) built on ECharts. Light/dark themes, ~5 KB gzip.",
  "keywords": [
    "react",
    "charts",
    "visualization",
    "echarts",
    "pie-chart",
    "bar-chart",
    "line-chart",
    "heatmap",
    "sankey",
    "funnel",
    "gauge",
    "dataviz"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/caiyin-bit/xviz/tree/main/minimal-viz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiyin-bit/xviz.git",
    "directory": "minimal-viz"
  },
  "bugs": {
    "url": "https://github.com/caiyin-bit/xviz/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:app": "vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit"
  },
  "peerDependencies": {
    "echarts": ">=5.0.0 <7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "echarts": "^6.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  }
}
